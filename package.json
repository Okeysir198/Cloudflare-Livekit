{
  "name": "livekit-voice-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "pages:build": "npx @cloudflare/next-on-pages",
    "pages:dev": "npx @cloudflare/next-on-pages --watch",
    "pages:deploy": "npm run pages:build && wrangler pages deploy .vercel/output/static",
    "db:create": "wrangler d1 create livekit-conversations",
    "db:schema": "wrangler d1 execute livekit-conversations --file=./sql/schema.sql",
    "db:seed": "wrangler d1 execute livekit-conversations --file=./sql/seed.sql",
    "db:schema:local": "wrangler d1 execute livekit-conversations --local --file=./sql/schema.sql",
    "db:seed:local": "wrangler d1 execute livekit-conversations --local --file=./sql/seed.sql"
  },
  "dependencies": {
    "@cloudflare/next-on-pages": "^1.13.5",
    "@livekit/components-react": "^2.6.3",
    "@livekit/protocol": "^1.24.0",
    "@phosphor-icons/react": "^2.1.7",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-toggle": "^1.1.1",
    "bcrypt-edge": "^0.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "livekit-client": "^2.6.1",
    "livekit-server-sdk": "^2.7.4",
    "next": "^15.1.3",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250117.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "wrangler": "^3.102.0"
  }
}
